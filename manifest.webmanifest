{
  "id": "./",
  "name": "Wedding Planner",
  "short_name": "Wedding",
  "description": "Vegetarian-first wedding planner with Google Drive sync between phone and computer.",
  "start_url": "./#overview",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#faf6f1",
  "theme_color": "#7a4e3a",
  "categories": ["lifestyle", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Checklist", "url": "./#timeline", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Budget", "url": "./#budget", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Guests", "url": "./#guests", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
